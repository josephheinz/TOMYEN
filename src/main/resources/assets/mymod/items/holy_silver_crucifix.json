{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "mymod:item/holy_silver_crucifix_icon"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:model",
        "model": "mymod:item/holy_silver_crucifix_raised"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "mymod:item/holy_silver_crucifix"
      }
    }
  }
}
