{
  "model": {
    "type": "minecraft:composite",
    "models": [
      {
        "type": "minecraft:condition",
        "property": "minecraft:has_component",
        "component": "mymod:optic_attachment",
        "on_true": {
          "type": "minecraft:condition",
          "property": "minecraft:has_component",
          "component": "mymod:loaded_magazine",
          "on_true": {
            "type": "minecraft:model",
            "model": "mymod:item/no_iron_sights/revolver_357"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "mymod:item/no_iron_sights/revolver_357_no_mag"
          }
        },
        "on_false": {
          "type": "minecraft:condition",
          "property": "minecraft:has_component",
          "component": "mymod:loaded_magazine",
          "on_true": {
            "type": "minecraft:model",
            "model": "mymod:item/revolver_357"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "mymod:item/revolver_357_no_mag"
          }
        }
      },
      {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "mymod:underbarrel_attachment",
        "cases": [
          {
            "when": "mymod:laser_sight",
            "model": {
              "type": "minecraft:model",
              "model": "mymod:item/attachment/revolver_357_laser_sight"
            }
          },
          {
            "when": "mymod:green_laser_sight",
            "model": {
              "type": "minecraft:model",
              "model": "mymod:item/attachment/revolver_357_green_laser_sight"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:empty"
        }
      },
      {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "mymod:optic_attachment",
        "cases": [
          {
            "when": "mymod:red_dot_sight",
            "model": {
              "type": "minecraft:model",
              "model": "mymod:item/attachment/revolver_357_red_dot_sight"
            }
          },
          {
            "when": "mymod:holographic_sight",
            "model": {
              "type": "minecraft:model",
              "model": "mymod:item/attachment/revolver_357_holographic_sight"
            }
          },
          {
            "when": "mymod:kobra_sight",
            "model": {
              "type": "minecraft:model",
              "model": "mymod:item/attachment/revolver_357_kobra_sight"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:empty"
        }
      },
      {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "mymod:underbarrel_attachment",
        "cases": [
          {
            "when": "mymod:flashlight",
            "model": {
              "type": "minecraft:model",
              "model": "mymod:item/attachment/revolver_357_flashlight"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:empty"
        }
      }
    ]
  }
}
