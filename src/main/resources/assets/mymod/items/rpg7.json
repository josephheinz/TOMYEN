{
  "model": {
    "type": "minecraft:composite",
    "models": [
      {
        "type": "minecraft:model",
        "model": "mymod:item/rpg7"
      },
      {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "mymod:loaded_rocket",
        "cases": [
          {
            "when": "mymod:pg7_rocket",
            "model": {
              "type": "minecraft:model",
              "model": "mymod:item/rpg7_warhead_pg7"
            }
          },
          {
            "when": "mymod:pg7_homing_rocket",
            "model": {
              "type": "minecraft:model",
              "model": "mymod:item/rpg7_warhead_pg7_homing"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:range_dispatch",
          "property": "mymod:gun_animation",
          "entries": [
            {
              "threshold": 0.5,
              "model": {
                "type": "minecraft:model",
                "model": "mymod:item/rpg7_warhead_pg7"
              }
            },
            {
              "threshold": 1.5,
              "model": {
                "type": "minecraft:model",
                "model": "mymod:item/rpg7_warhead_pg7_homing"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:empty"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "property": "minecraft:has_component",
        "component": "mymod:guidance_attachment",
        "on_true": {
          "type": "minecraft:model",
          "model": "mymod:item/rpg7_seeker"
        },
        "on_false": {
          "type": "minecraft:empty"
        }
      }
    ]
  }
}
